 "context_rule": {
  "num_ctx": 32768,
  "num_predict": 6000,
  "why_inline": "the frozen base system prompt forbids reading files (conditions/base_system.md), so every number of a case travels inside the problem text",
  "round0_fit": "max over the standard configurations of the rendered qwen3 prompt tokens (tokcount.OllamaCounter, think false) + num_predict <= num_ctx",
  "repair_rounds": "not required to fit: a round-2 prompt adds up to two answers and two repair messages; large texts are the stress part of the set (see the E22 record)"
 },
 "pglib_uc_rule": {
  "families": {
   "rts_gmlc": {
    "n_files": 12,
    "min_bytes": 89807,
    "max_bytes": 90934
   },
   "ca": {
    "n_files": 20,
    "min_bytes": 329326,
    "max_bytes": 331708
   },
   "ferc": {
    "n_files": 24,
    "min_bytes": 511598,
    "max_bytes": 515593
   }
  },
  "fits": "rts_gmlc only: its tables (73 thermal units; renewables aggregated per hour) render to about 14k qwen3 tokens; ca (610 units) and ferc (larger) render to over 110 KB of tables, beyond num_ctx",
  "draw": "random.Random('20260928:pglib_uc:v2:rts_gmlc').sample(sorted rts_gmlc days, 2)",
  "drawn": [
   "2020-11-25",
   "2020-03-05"
  ],
  "reference": "CBC <= 1800 s wall clock, ratioGap 1e-7; not closing the gap keeps the case with a time-limited reference (scored separately; the 30-minute stop of the E22 brief)"
 },
 "miplib_nl_rule": {
  "pool": "all 223 instance directories at the pinned commit (tree listing in sources/)",
  "size": "bytes of instance.json + data files (tree listing); byte-level BPE never yields more tokens than bytes",
  "strata": {
   "T": [
    0,
    3000
   ],
   "S": [
    3000,
    8000
   ],
   "L": [
    8000,
    22001
   ]
  },
  "strata_meaning": {
   "T": "tiny: data a model can transcribe within num_predict",
   "S": "small: borderline",
   "L": "large (stress): fits num_ctx at round 0, data too long to transcribe within num_predict"
  },
  "order": "random.Random('20260928:miplib_nl:v2:<stratum>').shuffle(sorted names); first 2 eligible per stratum",
  "eligibility": {
   "E1": "every file named in instance.json exists and converts verbatim",
   "E2": "optimal_value is a number (or a numeric string)",
   "E3": "round-0 fit (context_rule)",
   "E4": "CBC on the PuLP translation of the instance's solve.py, <= 1800 s wall clock: in strata T and S, CBC either closes the gap (cbc_optimal) or stops with an incumbent equal to optimal_value and a bound that does not contradict it (cbc_attains_published_optimum); in every stratum a CBC optimum must equal optimal_value within 1e-6 relative and a time-limited interval must contain it (otherwise the reference script and the published value disagree)",
   "E4_finalised": "2026-09-29 03:53 UTC, while five of the six screening solves of strata T and S started at 03:26 UTC were still running (they ended between 03:56 and 04:00 UTC, before any of their outcomes was known); the sixth, csched010, had ended at 03:26 UTC within a second without a solution, an outcome that leaves it ineligible under either wording. The first wording (optimality proof required in T and S) was widened because small MIPLIB instances are often hard for CBC and each further screening round costs 30 minutes (corrected 2026-09-29 by the E22 verification from the solve-record timestamps; the earlier text said none of the six outcomes was known)"
  },
