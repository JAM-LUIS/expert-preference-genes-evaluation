{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orgene.optimization_model_spec.v3",
  "title": "OptimizationModelSpec v3 (ORgene restart, 2026-09-05)",
  "description": "Reviewable formulation written before the program. Deliberately small: the fields an OR reviewer needs to check a model without reading code.",
  "type": "object",
  "required": ["problem_type", "decision_variables", "objective", "constraints", "assumptions"],
  "properties": {
    "problem_type": {"type": "string", "enum": ["LP", "MILP", "IP", "BIP", "other"]},
    "sets_and_parameters": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "meaning"],
                "properties": {"name": {"type": "string"}, "meaning": {"type": "string"}, "value": {}, "source": {"type": "string"}}}
    },
    "decision_variables": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name", "domain", "meaning"],
                "properties": {"name": {"type": "string"},
                               "domain": {"type": "string", "enum": ["continuous", "integer", "binary"]},
                               "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]},
                               "meaning": {"type": "string"}}}
    },
    "objective": {
      "type": "object", "required": ["sense", "expression"],
      "properties": {"sense": {"type": "string", "enum": ["min", "max"]},
                     "expression": {"type": "string"}, "meaning": {"type": "string"}}
    },
    "constraints": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name", "expression"],
                "properties": {"name": {"type": "string"}, "expression": {"type": "string"},
                               "source_sentence": {"type": "string"}}}
    },
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
